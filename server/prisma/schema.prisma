generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String
  role            String   // renter | landlord
  avatarUrl       String?
  emailVerified   Boolean  @default(false)
  emailToken      String?
  emailTokenExp   DateTime?
  resetToken      String?
  resetTokenExp   DateTime?
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties      Property[]         @relation("LandlordProperties")
  bookingRequests BookingRequest[]   @relation("RenterBookings")
  receivedBookings BookingRequest[]  @relation("LandlordBookings")
  reviews         Review[]
  favorites       Favorite[]

  @@map("users")
}

model Property {
  id            String   @id @default(uuid())
  title         String
  description   String
  price         Float
  currency      String   @default("USD")
  propertyType  String   // apartment | house | condo | studio
  status        String   @default("active") // active | inactive | draft
  bedrooms      Int
  bathrooms     Int
  squareFeet    Int
  yearBuilt     Int?
  floorNumber   Int?
  furnished     Boolean  @default(false)
  availableDate DateTime
  address       String
  city          String
  neighborhood  String
  latitude      Float
  longitude     Float
  amenities     String   @default("[]") // JSON array
  views         Int      @default(0)

  landlordId    String
  landlord      User     @relation("LandlordProperties", fields: [landlordId], references: [id])

  images        PropertyImage[]
  bookingRequests BookingRequest[]
  reviews       Review[]
  favorites     Favorite[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("properties")
}

model PropertyImage {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String
  order        Int      @default(0)

  createdAt    DateTime @default(now())

  @@map("property_images")
}

model BookingRequest {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  renterId        String
  renter          User     @relation("RenterBookings", fields: [renterId], references: [id])
  landlordId      String
  landlord        User     @relation("LandlordBookings", fields: [landlordId], references: [id])
  moveInDate      DateTime
  durationMonths  Int
  message         String
  status          String   @default("pending") // pending | accepted | rejected | cancelled
  responseMessage String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("booking_requests")
}

model Review {
  id                 String    @id @default(uuid())
  propertyId         String
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId           String
  renter             User      @relation(fields: [renterId], references: [id])
  rating             Int
  comment            String
  landlordResponse   String?
  landlordResponseAt DateTime?
  edited             Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([propertyId, renterId])
  @@map("reviews")
}

model Favorite {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@map("favorites")
}
