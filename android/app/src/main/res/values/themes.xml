<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme: shown before WebView loads -->
    <style name="Theme.RentHub.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.RentHub" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorPrimaryDark">@color/brand_700</item>
        <item name="colorAccent">@color/brand_600</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
